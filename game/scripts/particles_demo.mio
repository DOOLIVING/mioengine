// ========== PARTICLES DEMO ==========
// Demonstrates particle system

create_particles fire x = 512, y = 500, gravity = -150, min_vx = -30, max_vx = 30, min_vy = -120, max_vy = -60, min_life = 0.3, max_life = 0.8, min_size = 3, max_size = 8, end_size = 1, r = 1, g = 0.6, b = 0.1, a = 1, er = 1, eg = 0.1, eb = 0.05, ea = 0, rate = 40, max = 200

create_particles snow x = 512, y = -20, gravity = 30, min_vx = -20, max_vx = 20, min_vy = 20, max_vy = 50, min_life = 2, max_life = 4, min_size = 2, max_size = 5, end_size = 1, r = 0.9, g = 0.95, b = 1, a = 0.8, er = 0.7, eg = 0.8, eb = 1, ea = 0, rate = 15, max = 100, shape = "rect"

create_particles spark x = 300, y = 400, gravity = 200, min_vx = -80, max_vx = 80, min_vy = -150, max_vy = -50, min_life = 0.2, max_life = 0.5, min_size = 1, max_size = 4, end_size = 0, r = 0.3, g = 0.8, b = 1, a = 1, er = 0.1, eg = 0.3, eb = 1, ea = 0, burst = true, max = 100

on_update
    get_canvas_size => W, H
    // Move fire emitter with mouse
    let mx = _mousex or W / 2
    let my = _mousey or H / 2
    particles_set_pos fire, mx, 500
end

on_draw
    get_canvas_size => W, H

    draw_rect 0, 0, W, H, 0.05, 0.05, 0.08, 1

    draw_particles fire
    draw_particles snow
    draw_particles spark

    draw_text "PARTICLES DEMO", W / 2, 20, 28, 1, 1, 1, 1, center
    draw_text "Move mouse to control fire emitter", W / 2, 55, 12, 0.6, 0.6, 0.7, 0.7, center
    draw_text "Click to burst sparks", W / 2, 75, 12, 0.6, 0.6, 0.7, 0.7, center

    draw_text "Fire: " + str(particles_get_count fire), 10, H - 80, 11, 1, 0.6, 0.2, 0.8
    draw_text "Snow: " + str(particles_get_count snow), 10, H - 60, 11, 0.7, 0.8, 1, 0.8
    draw_text "Sparks: " + str(particles_get_count spark), 10, H - 40, 11, 0.3, 0.8, 1, 0.8

    ui_button W / 2 - 100, H - 45, 200, 35, "Menu" id = "menu"
    if ui_clicked "menu" then switch_scene "menu" end
end

on_mouse
    if _mouseaction == "pressed" then
        particles_burst spark, 30
    end
end

on_key "escape"
    switch_scene "menu"
end

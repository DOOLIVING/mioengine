// Rain particle effect
let maxParticles = 30
let rainCount = 0

let rainX = []
let rainY = []
let rainSpeed = []
let rainLen = []
let rainAlpha = []
let rainActive = []

on_update
    get_canvas_size => screenW, screenH
    if rainCount < maxParticles then
        let idx = rainCount + 1
        let rainX[idx] = random(screenW + 1) - 1
        let rainY[idx] = -5
        let rainSpeed[idx] = random(80) + 80
        let rainLen[idx] = random(5) + 3
        let rainAlpha[idx] = (random(40) + 20) / 100
        let rainActive[idx] = 1
        let rainCount = idx
    end

    for i = 1 to rainCount
        if rainActive[i] == 1 then
            let rainY[i] = rainY[i] + rainSpeed[i] * 0.016
            if rainY[i] > screenH + 10 then
                let rainActive[i] = 0
            end
        end
    end
end

on_draw
    get_canvas_size => screenW, screenH
    for i = 1 to rainCount
        if rainActive[i] == 1 then
            draw_line rainX[i], rainY[i], rainX[i] - 1, rainY[i] + rainLen[i], 0.6, 0.7, 0.9, rainAlpha[i], 1
        end
    end
end

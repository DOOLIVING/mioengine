// Doors - open/close with keys 1/2/3 or F near them

let doorWood = create_model from "models/deco_door_wood.txt" at -3, 0, 3
let doorStone = create_model from "models/deco_door_stone.txt" at 0, 0, 3
let doorIron = create_model from "models/deco_door_iron.txt" at 3, 0, 3

let doorOpen1 = 0
let doorOpen2 = 0
let doorOpen3 = 0
let doorY1 = 0
let doorY2 = 0
let doorY3 = 0

on_update
    // Wood door
    let targetY = 0
    if doorOpen1 == 1 then
        let targetY = 1.5
    end
    let doorY1 = doorY1 + (targetY - doorY1) * 0.06
    set_pos doorWood to -3, doorY1, 3

    // Stone door
    let targetY = 0
    if doorOpen2 == 1 then
        let targetY = 1.5
    end
    let doorY2 = doorY2 + (targetY - doorY2) * 0.06
    set_pos doorStone to 0, doorY2, 3

    // Iron door
    let targetY = 0
    if doorOpen3 == 1 then
        let targetY = 1.5
    end
    let doorY3 = doorY3 + (targetY - doorY3) * 0.06
    set_pos doorIron to 3, doorY3, 3
end

on_key "1"
    if doorOpen1 == 0 then
        let doorOpen1 = 1
        say "Wood door opened"
    else
        let doorOpen1 = 0
        say "Wood door closed"
    end
end

on_key "2"
    if doorOpen2 == 0 then
        let doorOpen2 = 1
        say "Stone door opened"
    else
        let doorOpen2 = 0
        say "Stone door closed"
    end
end

on_key "3"
    if doorOpen3 == 0 then
        let doorOpen3 = 1
        say "Iron door opened"
    else
        let doorOpen3 = 0
        say "Iron door closed"
    end
end

on_key "f"
    get_pos camera => cx, cy, cz
    get_pos doorWood => dx, dy, dz
    if dist(cx, cy, cz, dx, 0, dz) < 2 then
        if doorOpen1 == 0 then
            let doorOpen1 = 1
            say "Wood door opened"
        else
            let doorOpen1 = 0
            say "Wood door closed"
        end
    end
    get_pos doorStone => dx, dy, dz
    if dist(cx, cy, cz, dx, 0, dz) < 2 then
        if doorOpen2 == 0 then
            let doorOpen2 = 1
            say "Stone door opened"
        else
            let doorOpen2 = 0
            say "Stone door closed"
        end
    end
    get_pos doorIron => dx, dy, dz
    if dist(cx, cy, cz, dx, 0, dz) < 2 then
        if doorOpen3 == 0 then
            let doorOpen3 = 1
            say "Iron door opened"
        else
            let doorOpen3 = 0
            say "Iron door closed"
        end
    end
end

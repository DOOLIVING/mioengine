// ========== 2D DEMO ==========
// Пример 2D проекта с текстурами

on_draw
    get_canvas_size => W, H

    // Фон - небо
    draw_rect 0, 0, W, H, 0.4, 0.6, 0.9, 1

    // Земля
    draw_rect 0, H - 120, W, 120, 0.35, 0.55, 0.25, 1

    // Текстура patron.png как "пулемет" на земле
    draw_sprite "assets/patron.png", 100, H - 180, 1, 1, 1, 1, 2, 2
    draw_sprite "assets/patron.png", 250, H - 170, 1, 0.8, 0.3, 1, 1.5, 1.5
    draw_sprite "assets/patron.png", 400, H - 190, 0.3, 1, 0.5, 1, 2.5, 2.5

    // Текстура texture.png как "платформа"
    draw_sprite "assets/texture.png", 500, H - 250, 1, 1, 1, 1, 3, 1
    draw_sprite "assets/texture.png", 700, H - 300, 1, 1, 1, 1, 2, 1

    // Текстура как "враг"
    let t = math.sin(os.clock() * 2) * 20
    draw_sprite "assets/patron.png", W / 2, H / 2 + t, 1, 0.2, 0.2, 1, 3, 3

    // UI
    draw_text "2D SPRITE TEST", W / 2, 20, 28, 1, 1, 1, 1, center
    draw_text "patron.png x3 + texture.png x2", W / 2, 55, 14, 0.8, 0.8, 0.9, 0.8, center

    // Кнопка назад
    ui_button W / 2 - 100, H - 60, 200, 40, "Back to Menu" id = "back"
    if ui_clicked "back" then
        switch_scene "menu"
    end
end

on_key "escape"
    switch_scene "menu"
end

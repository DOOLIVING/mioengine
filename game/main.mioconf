default_scene=demo

[window]
title=MioEngine Test
width=800
height=600
resizable=true

[renderer]
width=320
height=240
fov=60
snap_size=40
fog_density=0.015

[camera]
x=0
y=1.5
z=5
speed=5
sensitivity=2
fov=60

[scene:menu]
script=game/scripts/menu.mio

[scene:demo]
script=game/scripts/demo.mio

[scene:test]
script=game/scripts/demo.mio

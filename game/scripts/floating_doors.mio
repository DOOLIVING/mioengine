// 3 деревянных двери, одна парит как ключ

let door1 = create_model from "models/deco_door_wood.txt" at -2, 0, 0
let door2 = create_model from "models/deco_door_wood.txt" at 2, 0, 0
let door3 = create_model from "models/deco_door_wood.txt" at 0, 0, 1

let _time = 0
let floatBaseY = 0

get_pos door3 => x3, floatBaseY, z3

on_update
    let _time = _time + 0.016

    // door3 парит вверх-вниз и вращается
    let newY = floatBaseY + sin(_time * 2) * 0.5
    set_pos door3 to x3, newY, z3
    set_rot y door3 1.2
    set_rot x door3 0.3
end

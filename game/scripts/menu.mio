// menu.mio -Главное меню

setup_camera 0, 1, 5 speed 3 sensitivity 2
setup_renderer 320, 240 fov 60
set_mouse visible

on_draw
    draw_rect 0, 0, 320, 240, 0.05, 0.05, 0.1
    draw_text "MIOENGINE", 160, 60, 20, 1, 1, 1, 1, center
    draw_text "3D Game Engine", 160, 90, 10, 0.6, 0.6, 0.7, 0.8, center
    draw_text "Press 1 - Demo Scene", 160, 150, 12, 0.8, 0.9, 1.0, 1, center
    draw_text "Press 2 - Test Scene", 160, 175, 12, 0.8, 0.9, 1.0, 1, center
    draw_text "Press ESC - Quit", 160, 210, 10, 0.5, 0.5, 0.6, 0.7, center
end

on_key "1"
    switch_scene "demo"
end

on_key "2"
    switch_scene "test"
end

on_key "escape"
    exit_game
end

// Ammo chests - press E near chest to get ammo for current weapon
let _time = 0

let chest1 = create_model from "models/deco_chest.txt" at 4, 0, 3 rotatey 0.5
let chest2 = create_model from "models/deco_chest.txt" at -5, 0, -2 rotatey 1.2
let chest3 = create_model from "models/deco_chest.txt" at 2, 0, -3 rotatey 2.0
let chest4 = create_model from "models/deco_chest.txt" at -3, 0, 6 rotatey 0.8

let alive1 = 1
let alive2 = 1
let alive3 = 1
let alive4 = 1

let ammoMessage = ""
let ammoTimer = 0

on_update
    let _time = _time + 0.016
    if alive1 == 1 then
        set_rot angle_y chest1 _time * 0.8
    end
    if alive2 == 1 then
        set_rot angle_y chest2 _time * 0.7
    end
    if alive3 == 1 then
        set_rot angle_y chest3 _time * 0.9
    end
    if alive4 == 1 then
        set_rot angle_y chest4 _time * 0.6
    end
    if ammoTimer > 0 then
        let ammoTimer = ammoTimer - 0.016
    end
end

on_draw
    if ammoTimer > 0 then
        let aa = min(ammoTimer, 1)
        draw_text ammoMessage, 160, 80, 9, 0.3, 1.0, 0.3, aa, center
    end
end

on_key "e"
    get_pos camera => cx, cy, cz
    if alive1 == 1 then
        get_pos chest1 => ox, oy, oz
        if dist(cx, cy, cz, ox, oy, oz) < 2 then
            destroy chest1
            let alive1 = 0
            if currentWeapon == 1 then
                let pistolReserve = pistolReserve + 12
                let ammoMessage = "+12 PISTOL AMMO"
            end
            if currentWeapon == 2 then
                let rifleReserve = rifleReserve + 30
                let ammoMessage = "+30 RIFLE AMMO"
            end
            if currentWeapon == 3 then
                let shotgunReserve = shotgunReserve + 8
                let ammoMessage = "+8 SHOTGUN AMMO"
            end
            if currentWeapon == 0 then
                let ammoMessage = "NO WEAPON EQUIPPED"
            end
            let ammoTimer = 2
        end
    end
    if alive2 == 1 then
        get_pos chest2 => ox, oy, oz
        if dist(cx, cy, cz, ox, oy, oz) < 2 then
            destroy chest2
            let alive2 = 0
            if currentWeapon == 1 then
                let pistolReserve = pistolReserve + 12
                let ammoMessage = "+12 PISTOL AMMO"
            end
            if currentWeapon == 2 then
                let rifleReserve = rifleReserve + 30
                let ammoMessage = "+30 RIFLE AMMO"
            end
            if currentWeapon == 3 then
                let shotgunReserve = shotgunReserve + 8
                let ammoMessage = "+8 SHOTGUN AMMO"
            end
            if currentWeapon == 0 then
                let ammoMessage = "NO WEAPON EQUIPPED"
            end
            let ammoTimer = 2
        end
    end
    if alive3 == 1 then
        get_pos chest3 => ox, oy, oz
        if dist(cx, cy, cz, ox, oy, oz) < 2 then
            destroy chest3
            let alive3 = 0
            if currentWeapon == 1 then
                let pistolReserve = pistolReserve + 12
                let ammoMessage = "+12 PISTOL AMMO"
            end
            if currentWeapon == 2 then
                let rifleReserve = rifleReserve + 30
                let ammoMessage = "+30 RIFLE AMMO"
            end
            if currentWeapon == 3 then
                let shotgunReserve = shotgunReserve + 8
                let ammoMessage = "+8 SHOTGUN AMMO"
            end
            if currentWeapon == 0 then
                let ammoMessage = "NO WEAPON EQUIPPED"
            end
            let ammoTimer = 2
        end
    end
    if alive4 == 1 then
        get_pos chest4 => ox, oy, oz
        if dist(cx, cy, cz, ox, oy, oz) < 2 then
            destroy chest4
            let alive4 = 0
            if currentWeapon == 1 then
                let pistolReserve = pistolReserve + 12
                let ammoMessage = "+12 PISTOL AMMO"
            end
            if currentWeapon == 2 then
                let rifleReserve = rifleReserve + 30
                let ammoMessage = "+30 RIFLE AMMO"
            end
            if currentWeapon == 3 then
                let shotgunReserve = shotgunReserve + 8
                let ammoMessage = "+8 SHOTGUN AMMO"
            end
            if currentWeapon == 0 then
                let ammoMessage = "NO WEAPON EQUIPPED"
            end
            let ammoTimer = 2
        end
    end
end

// ========== 3D PHYSICS DEMO ==========
// Fixed timestep, spatial hash, sequential impulse solver

setup_camera 0, 8, -14 speed 8 sensitivity 0.002
setup_renderer 320, 240 fov 200
set_mouse relative

set_physics3d_gravity 0, 600, 0
set_physics3d_floor 0

// === FLOOR ===
add_object floor from "models/floor.txt" at 0, 0, 0

// === WALLS (perimeter) ===
add_object w_n from "models/cube.txt" at 0, 3, 10 scale 1
set_physics3d w_n, "static", w = 20, h = 6, d = 0.4, tag = "wall"

add_object w_s from "models/cube.txt" at 0, 3, -10 scale 1
set_physics3d w_s, "static", w = 20, h = 6, d = 0.4, tag = "wall"

add_object w_w from "models/cube.txt" at -10, 3, 0 scale 1
set_physics3d w_w, "static", w = 0.4, h = 6, d = 20, tag = "wall"

add_object w_e from "models/cube.txt" at 10, 3, 0 scale 1
set_physics3d w_e, "static", w = 0.4, h = 6, d = 20, tag = "wall"

// === PLATFORMS (staircase left-up) ===
add_object plat1 from "models/cube.txt" at -7, 2, -5 scale 1
set_physics3d plat1, "static", w = 4, h = 0.4, d = 2, tag = "platform"

add_object plat2 from "models/cube.txt" at -3, 4, -2 scale 1
set_physics3d plat2, "static", w = 3, h = 0.4, d = 2, tag = "platform"

add_object plat3 from "models/cube.txt" at 2, 6, 0 scale 1
set_physics3d plat3, "static", w = 3, h = 0.4, d = 2, tag = "platform"

add_object plat4 from "models/cube.txt" at 6, 8, 3 scale 1
set_physics3d plat4, "static", w = 2.5, h = 0.4, d = 2, tag = "platform"

add_object plat5 from "models/cube.txt" at 2, 10, 6 scale 1
set_physics3d plat5, "static", w = 3, h = 0.4, d = 2, tag = "platform"

add_object plat6 from "models/cube.txt" at -5, 12, 4 scale 1
set_physics3d plat6, "static", w = 3.5, h = 0.4, d = 2, tag = "platform"

// === DYNAMIC BOXES (scattered, different sizes) ===
add_object box1 from "models/cube.txt" at -6, 4, -3 scale 1
set_physics3d box1, "dynamic", w = 0.8, h = 0.8, d = 0.8, bounce = 0.3, friction = 0.7, tag = "box"

add_object box2 from "models/cube.txt" at 4, 6, -5 scale 1
set_physics3d box2, "dynamic", w = 0.6, h = 0.6, d = 0.6, bounce = 0.5, friction = 0.5, tag = "box"

add_object box3 from "models/cube.txt" at -2, 8, 4 scale 1
set_physics3d box3, "dynamic", w = 1, h = 1, d = 1, bounce = 0.2, friction = 0.8, tag = "box"

add_object box4 from "models/cube.txt" at 7, 10, -2 scale 1
set_physics3d box4, "dynamic", w = 1.2, h = 1.2, d = 1.2, bounce = 0.4, friction = 0.6, tag = "box"

add_object box5 from "models/cube.txt" at -8, 12, 1 scale 1
set_physics3d box5, "dynamic", w = 0.9, h = 0.9, d = 0.9, bounce = 0.7, friction = 0.3, tag = "box"

add_object box6 from "models/cube.txt" at 0, 14, 0 scale 1
set_physics3d box6, "dynamic", w = 1.5, h = 1.5, d = 1.5, bounce = 0.1, friction = 0.9, tag = "box"

// === HIGH BOXES ===
add_object box7 from "models/cube.txt" at 5, 17, 5 scale 1
set_physics3d box7, "dynamic", w = 0.7, h = 0.7, d = 0.7, bounce = 0.6, friction = 0.4, tag = "box"

add_object box8 from "models/cube.txt" at -4, 20, -4 scale 1
set_physics3d box8, "dynamic", w = 0.5, h = 0.5, d = 0.5, bounce = 0.9, friction = 0.2, tag = "box"

// === BIG BOX FALLS FROM SKY ===
add_object box9 from "models/cube.txt" at 0, 22, 0 scale 1
set_physics3d box9, "dynamic", w = 2, h = 2, d = 2, bounce = 0.3, friction = 0.7, tag = "box"

// === PARTICLES ===
create_particles3d fire x = 0, y = 0, z = 8, gravity = -40, min_vx = -15, max_vx = 15, min_vy = -60, max_vy = -20, min_vz = -15, max_vz = 15, min_life = 0.5, max_life = 1.5, min_size = 1, max_size = 3, end_size = 0, r = 1, g = 0.5, b = 0, a = 0.9, er = 1, eg = 0.1, eb = 0, ea = 0, rate = 30, max = 100

create_particles3d sparks x = 0, y = 1, z = 0, gravity = 300, min_vx = -50, max_vx = 50, min_vy = -80, max_vy = -20, min_vz = -50, max_vz = 50, min_life = 0.2, max_life = 0.8, min_size = 1, max_size = 3, end_size = 0, r = 1, g = 0.8, b = 0.2, a = 1, er = 1, eg = 0.2, eb = 0, ea = 0, burst = true, max = 150

on_update
    camera_collide
end

on_draw
    draw_particles3d fire
    draw_particles3d sparks

    get_canvas_size => W, H

    draw_text "3D PHYSICS", W / 2, 6, 14, 1, 1, 1, 1, center
    draw_text "WASD=move  Mouse=look  Shift=sprint", W / 2, 20, 8, 0.6, 0.7, 0.7, 0.8, center
    draw_text "Click=sparks", W / 2, 30, 8, 0.8, 0.6, 0.3, 0.8, center

    let _cx = floor(camera.x * 10) / 10
    let _cy = floor(camera.y * 10) / 10
    let _cz = floor(camera.z * 10) / 10
    draw_text "cam: " + str(_cx) + " " + str(_cy) + " " + str(_cz), 10, 46, 8, 0.7, 0.8, 0.7, 0.8

    draw_text "fire: " + str(particles3d_get_count fire), 10, H - 40, 8, 1, 0.5, 0, 0.8
    draw_text "sparks: " + str(particles3d_get_count sparks), 10, H - 28, 8, 1, 0.8, 0.2, 0.8

    ui_button W / 2 - 60, H - 18, 120, 16, "Menu" id = "menu"
    if ui_clicked "menu" then switch_scene "menu" end
end

on_mouse
    if _mouseaction == "pressed" then
        let camX = camera.x
        let camY = camera.y
        let camZ = camera.z
        particles3d_set_pos sparks, camX, camY, camZ
        particles3d_burst sparks, 40
    end
end

on_key "escape"
    switch_scene "menu"
end

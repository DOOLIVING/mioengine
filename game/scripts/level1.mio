        let rp2 = create_model from "models/deco_red_square.txt" at _rx, _ry, _rz scale 1
        let rp3 = create_model from "models/deco_red_square.txt" at _rx, _ry, _rz scale 1
        let rp4 = create_model from "models/deco_red_square.txt" at _rx, _ry, _rz scale 1
        let rp5 = create_model from "models/deco_red_square.txt" at _rx, _ry, _rz scale 1
        let rp6 = create_model from "models/deco_red_square.txt" at _rx, _ry, _rz scale 1
        let rp7 = create_model from "models/deco_red_square.txt" at _rx, _ry, _rz scale 1
        let rp8 = create_model from "models/deco_red_square.txt" at _rx, _ry, _rz scale 1
        let rpv1x = 8
        let rpv1y = 12
        let rpv1z = 8
        let rpv2x = -8
        let rpv2y = 10
        let rpv2z = 8
        let rpv3x = 8
        let rpv3y = 14
        let rpv3z = -8
        let rpv4x = -8
        let rpv4y = 11
        let rpv4z = -8
        let rpv5x = 10
        let rpv5y = 16
        let rpv5z = 0
        let rpv6x = -10
        let rpv6y = 13
        let rpv6z = 0
        let rpv7x = 0
        let rpv7y = 15
        let rpv7z = 10
        let rpv8x = 0
        let rpv8y = 12
        let rpv8z = -10
        let rp_alive = 1
        let rp_timer = 0
    end

    // skull1 AI: follow + face + shoot
    if skull1_alive == 1 then
        let _dx1 = camera.x - skull1.x
        let _dz1 = camera.z - skull1.z
        let _sd1 = dist(skull1.x, skull1.y, skull1.z, camera.x, camera.y, camera.z)
        // face player
        if _sd1 > 0.1 then
            let _angle1 = atan2(_dx1, -_dz1)
            set_rot skull1 angle_y _angle1
        end
        // follow player (stop at close range)
        if _sd1 > 5 then
            move skull1 towards camera speed skull_speed
        end
        // melee attack
        if _sd1 < 2.5 then
            let skull_attack_timer = skull_attack_timer - 0.016
            if skull_attack_timer <= 0 then
                let player_hp = player_hp - skull_damage
                let skull_attack_timer = 1.0
            end
        end
        // ranged attack: spawn visible bullet
        if skull1_shoot_timer <= 0 and _sd1 > 3 and bullet1_active == 0 then
            let bullet1 = create_model from "models/deco_skull.txt" at skull1.x, 1, skull1.z scale 1
            let bullet1_vx = _dx1 / _sd1 * bullet_speed
            let bullet1_vz = _dz1 / _sd1 * bullet_speed
            let bullet1_active = 1
            let skull1_shoot_timer = 0.8
        end
    end

    // skull2 AI: follow + face + shoot
    if skull2_alive == 1 then
        let _dx2 = camera.x - skull2.x
        let _dz2 = camera.z - skull2.z
        let _sd2 = dist(skull2.x, skull2.y, skull2.z, camera.x, camera.y, camera.z)
        // face player
        if _sd2 > 0.1 then
            let _angle2 = atan2(_dx2, -_dz2)
            set_rot skull2 angle_y _angle2
        end
        // follow player (stop at close range)
        if _sd2 > 5 then
            move skull2 towards camera speed skull_speed
        end
        // melee attack
        if _sd2 < 2.5 then
            let skull_attack_timer = skull_attack_timer - 0.016
            if skull_attack_timer <= 0 then
                let player_hp = player_hp - skull_damage
                let skull_attack_timer = 1.0
            end
        end
        // ranged attack: spawn visible bullet
        if skull2_shoot_timer <= 0 and _sd2 > 3 and bullet2_active == 0 then
            let bullet2 = create_model from "models/deco_skull.txt" at skull2.x, 1, skull2.z scale 1
            let bullet2_vx = _dx2 / _sd2 * bullet_speed
            let bullet2_vz = _dz2 / _sd2 * bullet_speed
            let bullet2_active = 1
            let skull2_shoot_timer = 0.8
        end
    end

    // bullet1 movement + hit check
    if bullet1_active == 1 then
        let _bdt = 0.016
        move bullet1 by bullet1_vx * _bdt, 0, bullet1_vz * _bdt
        let _bd1 = dist(bullet1.x, bullet1.y, bullet1.z, camera.x, camera.y, camera.z)
        if _bd1 < 1.5 then
            let player_hp = player_hp - 5
            destroy bullet1
            let bullet1_active = 0
        else
            if _bd1 > 40 then
                destroy bullet1
                let bullet1_active = 0
            end
        end
    end

    // bullet2 movement + hit check
    if bullet2_active == 1 then
        let _bdt = 0.016
        move bullet2 by bullet2_vx * _bdt, 0, bullet2_vz * _bdt
        let _bd2 = dist(bullet2.x, bullet2.y, bullet2.z, camera.x, camera.y, camera.z)
        if _bd2 < 1.5 then
            let player_hp = player_hp - 5
            destroy bullet2
            let bullet2_active = 0
        else
            if _bd2 > 40 then
                destroy bullet2
                let bullet2_active = 0
            end
        end
    end

    // skull1 death + particles
    if skull1_hp <= 0 and skull1_alive == 1 then
        let skull1_alive = 0
        let _skx = skull1.x
        let _sky = skull1.y
        let _skz = skull1.z
        destroy skull1
        let score = score + 10
        if bullet1_active == 1 then
            destroy bullet1
            let bullet1_active = 0
        end
        let p1 = create_model from "models/deco_skull.txt" at _skx, _sky, _skz scale 1
        let p2 = create_model from "models/deco_skull.txt" at _skx, _sky, _skz scale 1
        let p3 = create_model from "models/deco_skull.txt" at _skx, _sky, _skz scale 1
        let p4 = create_model from "models/deco_skull.txt" at _skx, _sky, _skz scale 1
        let p5 = create_model from "models/deco_skull.txt" at _skx, _sky, _skz scale 1
        let p6 = create_model from "models/deco_skull.txt" at _skx, _sky, _skz scale 1
        let p7 = create_model from "models/deco_skull.txt" at _skx, _sky, _skz scale 1
        let p8 = create_model from "models/deco_skull.txt" at _skx, _sky, _skz scale 1
        let pv1x = 8
        let pv1y = 12
        let pv1z = 8
        let pv2x = -8
        let pv2y = 10
        let pv2z = 8
        let pv3x = 8
        let pv3y = 14
        let pv3z = -8
        let pv4x = -8
        let pv4y = 11
        let pv4z = -8
        let pv5x = 10
        let pv5y = 16
        let pv5z = 0
        let pv6x = -10
        let pv6y = 13
        let pv6z = 0
        let pv7x = 0
        let pv7y = 15
        let pv7z = 10
        let pv8x = 0
        let pv8y = 12
        let pv8z = -10
        let particles_alive = 1
    end

    // skull2 death + particles
    if skull2_hp <= 0 and skull2_alive == 1 then
        let skull2_alive = 0
        let _skx = skull2.x
        let _sky = skull2.y
        let _skz = skull2.z
        destroy skull2
        let score = score + 10
        if bullet2_active == 1 then
            destroy bullet2
            let bullet2_active = 0
        end
        let p1 = create_model from "models/deco_skull.txt" at _skx, _sky, _skz scale 1
        let p2 = create_model from "models/deco_skull.txt" at _skx, _sky, _skz scale 1
        let p3 = create_model from "models/deco_skull.txt" at _skx, _sky, _skz scale 1
        let p4 = create_model from "models/deco_skull.txt" at _skx, _sky, _skz scale 1
        let p5 = create_model from "models/deco_skull.txt" at _skx, _sky, _skz scale 1
        let p6 = create_model from "models/deco_skull.txt" at _skx, _sky, _skz scale 1
        let p7 = create_model from "models/deco_skull.txt" at _skx, _sky, _skz scale 1
        let p8 = create_model from "models/deco_skull.txt" at _skx, _sky, _skz scale 1
        let pv1x = 8
        let pv1y = 12
        let pv1z = 8
        let pv2x = -8
        let pv2y = 10
        let pv2z = 8
        let pv3x = 8
        let pv3y = 14
        let pv3z = -8
        let pv4x = -8
        let pv4y = 11
        let pv4z = -8
        let pv5x = 10
        let pv5y = 16
        let pv5z = 0
        let pv6x = -10
        let pv6y = 13
        let pv6z = 0
        let pv7x = 0
        let pv7y = 15
        let pv7z = 10
        let pv8x = 0
        let pv8y = 12
        let pv8z = -10
        let particles_alive = 1
    end

    // update particles
    if particles_alive == 1 then
        let _pd = 0.016
        let particle_timer = particle_timer + _pd
        move p1 by pv1x * _pd, pv1y * _pd, pv1z * _pd
        move p2 by pv2x * _pd, pv2y * _pd, pv2z * _pd
        move p3 by pv3x * _pd, pv3y * _pd, pv3z * _pd
        move p4 by pv4x * _pd, pv4y * _pd, pv4z * _pd
        move p5 by pv5x * _pd, pv5y * _pd, pv5z * _pd
        move p6 by pv6x * _pd, pv6y * _pd, pv6z * _pd
        move p7 by pv7x * _pd, pv7y * _pd, pv7z * _pd
        move p8 by pv8x * _pd, pv8y * _pd, pv8z * _pd
        // gravity
        let pv1y = pv1y - 20 * _pd
        let pv2y = pv2y - 20 * _pd
        let pv3y = pv3y - 20 * _pd
        let pv4y = pv4y - 20 * _pd
        let pv5y = pv5y - 20 * _pd
        let pv6y = pv6y - 20 * _pd
        let pv7y = pv7y - 20 * _pd
        let pv8y = pv8y - 20 * _pd
        // destroy after 2 seconds
        if particle_timer >= 2 then
            destroy p1
            destroy p2
            destroy p3
            destroy p4
            destroy p5
            destroy p6
            destroy p7
            destroy p8
            let particles_alive = 0
            let particle_timer = 0
        end
    end

    // Red Square particles update
    if rp_alive == 1 then
        let _rpd = 0.016
        let rp_timer = rp_timer + _rpd
        move rp1 by rpv1x * _rpd, rpv1y * _rpd, rpv1z * _rpd
        move rp2 by rpv2x * _rpd, rpv2y * _rpd, rpv2z * _rpd
        move rp3 by rpv3x * _rpd, rpv3y * _rpd, rpv3z * _rpd
        move rp4 by rpv4x * _rpd, rpv4y * _rpd, rpv4z * _rpd
        move rp5 by rpv5x * _rpd, rpv5y * _rpd, rpv5z * _rpd
        move rp6 by rpv6x * _rpd, rpv6y * _rpd, rpv6z * _rpd
        move rp7 by rpv7x * _rpd, rpv7y * _rpd, rpv7z * _rpd
        move rp8 by rpv8x * _rpd, rpv8y * _rpd, rpv8z * _rpd
        let rpv1y = rpv1y - 20 * _rpd
        let rpv2y = rpv2y - 20 * _rpd
        let rpv3y = rpv3y - 20 * _rpd
        let rpv4y = rpv4y - 20 * _rpd
        let rpv5y = rpv5y - 20 * _rpd
        let rpv6y = rpv6y - 20 * _rpd
        let rpv7y = rpv7y - 20 * _rpd
        let rpv8y = rpv8y - 20 * _rpd
        if rp_timer >= 2 then
            destroy rp1
            destroy rp2
            destroy rp3
            destroy rp4
            destroy rp5
            destroy rp6
            destroy rp7
            destroy rp8
            let rp_alive = 0
            let rp_timer = 0
        end
    end

    // reload timer
    if isReloading == 1 then
        let reloadTimer = reloadTimer - 0.016
        if reloadTimer <= 0 then
            let isReloading = 0
            let reloadTimer = 0
            if currentWeapon == 1 then
                let _need = pistolMagSize - pistolAmmo
                if _need > pistolReserve then
                    let _need = pistolReserve
                end
                let pistolAmmo = pistolAmmo + _need
                let pistolReserve = pistolReserve - _need
            end
            if currentWeapon == 2 then
                let _need = rifleMagSize - rifleAmmo
                if _need > rifleReserve then
                    let _need = rifleReserve
                end
                let rifleAmmo = rifleAmmo + _need
                let rifleReserve = rifleReserve - _need
            end
            if currentWeapon == 3 then
                let _need = shotgunMagSize - shotgunAmmo
                if _need > shotgunReserve then
                    let _need = shotgunReserve
                end
                let shotgunAmmo = shotgunAmmo + _need
                let shotgunReserve = shotgunReserve - _need
            end
        end
    end

    // pickup check - pick up all weapons
    let px = camera.x
    let pz = camera.z
    if hasPistol == 0 then
        let d1 = dist(px, 0, pz, -1, 0.5, -5)
        if d1 < 2 then
            let hasPistol = 1
            let currentWeapon = 1
            let weaponName = "PISTOL"
            let pickupMessage = "PICKUP: PISTOL"
            let pickupTimer = 2
            destroy pistol
        end
    end
    if hasRifle == 0 then
        let d2 = dist(px, 0, pz, 1, 0.5, -5)
        if d2 < 2 then
            let hasRifle = 1
            let currentWeapon = 2
            let weaponName = "RIFLE"
            let pickupMessage = "PICKUP: RIFLE"
            let pickupTimer = 2
            destroy rifle
        end
    end
    if hasShotgun == 0 then
        let d3 = dist(px, 0, pz, 0, 0.5, -5.5)
        if d3 < 2 then
            let hasShotgun = 1
            let currentWeapon = 3
            let weaponName = "SHOTGUN"
            let pickupMessage = "PICKUP: SHOTGUN"
            let pickupTimer = 2
            destroy shotgun
        end
    end

    // blasters rotate on ground (only if not picked up)
    if hasPistol == 0 then
        set_rot angle_y pistol _time * 0.8
        pistol.y = 0.5 + sin(_time * 1.5) * 0.05
    end
    if hasRifle == 0 then
        set_rot angle_y rifle _time * 0.6
        rifle.y = 0.5 + sin(_time * 1.8 + 1) * 0.05
    end
    if hasShotgun == 0 then
        set_rot angle_y shotgun _time * 0.5
        shotgun.y = 0.5 + sin(_time * 1.2 + 2) * 0.05
    end
end

on_mouse
    if _mousebutton == 1 and _mouseaction == "pressed" then
        if currentWeapon > 0 and isReloading == 0 then
            let _canShoot = 0
            if currentWeapon == 1 and pistolAmmo > 0 then
                let _canShoot = 1
                let pistolAmmo = pistolAmmo - 1
            end
            if currentWeapon == 2 and rifleAmmo > 0 then
                let _canShoot = 1
                let rifleAmmo = rifleAmmo - 1
            end
            if currentWeapon == 3 and shotgunAmmo > 0 then
                let _canShoot = 1
                let shotgunAmmo = shotgunAmmo - 1
            end
                if _canShoot == 1 then
                    let shootAnim = 0.2
                    let muzzleFlash = 0.1
                    // Hit detection on skulls
                    if skull1_alive == 1 then
                        check_hit skull1.x, skull1.y, skull1.z
                        if _hitResult == 1 then
                            let skull1_hp = skull1_hp - 25
                            let skull_hit_timer = 0.3
                        end
                    end
                    if skull2_alive == 1 then
                        check_hit skull2.x, skull2.y, skull2.z
                        if _hitResult == 1 then
                            let skull2_hp = skull2_hp - 25
                            let skull_hit_timer = 0.3
                        end
                    end
                    // Hit detection on red squares
                    if rs1_alive == 1 then
                        check_hit rs1.x, rs1.y, rs1.z
                        if _hitResult == 1 then
                            let rs1_hp = rs1_hp - 25
                        end
                    end
                    if rs2_alive == 1 then
                        check_hit rs2.x, rs2.y, rs2.z
                        if _hitResult == 1 then
                            let rs2_hp = rs2_hp - 25
                        end
                    end
                    if rs3_alive == 1 then
                        check_hit rs3.x, rs3.y, rs3.z
                        if _hitResult == 1 then
                            let rs3_hp = rs3_hp - 25
                        end
                    end
                    if rs4_alive == 1 then
                        check_hit rs4.x, rs4.y, rs4.z
                        if _hitResult == 1 then
                            let rs4_hp = rs4_hp - 25
                        end
                    end
                end
        end
    end
end

on_key "m"
    mute
end

on_key "r"
    if currentWeapon > 0 and isReloading == 0 then
        let _canReload = 0
        if currentWeapon == 1 and pistolAmmo < pistolMagSize and pistolReserve > 0 then
            let _canReload = 1
            let reloadTime = 1.0
            let reloadTimer = 1.0
        end
        if currentWeapon == 2 and rifleAmmo < rifleMagSize and rifleReserve > 0 then
            let _canReload = 1
            let reloadTime = 2.0
            let reloadTimer = 2.0
        end
        if currentWeapon == 3 and shotgunAmmo < shotgunMagSize and shotgunReserve > 0 then
            let _canReload = 1
            let reloadTime = 1.8
            let reloadTimer = 1.8
        end
        if _canReload == 1 then
            let isReloading = 1
            let shootAnim = 0
            let muzzleFlash = 0
        end
    end
end

on_key "1"
    if hasPistol == 1 then
        let currentWeapon = 1
        let weaponName = "PISTOL"
    end
end

on_key "2"
    if hasRifle == 1 then
        let currentWeapon = 2
        let weaponName = "RIFLE"
    end
end

on_key "3"
    if hasShotgun == 1 then
        let currentWeapon = 3
        let weaponName = "SHOTGUN"
    end
end

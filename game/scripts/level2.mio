// ========== LEVEL 2 ==========

setup_camera 0, 2.5, -3 speed 7 sensitivity 0.0025
setup_renderer 320, 240 fov 200
load_texture "assets/texture.png"
set_mouse relative

add_object floor from "models/floor.txt" at 0, 0, 0 draworder 0

// === IRON FENCE PERIMETER (floor -30..30) ===
// Front (z = -30)
add_object fp1 from "models/fence_simple.txt" at -27, 0, -30
add_object fp2 from "models/fence_simple.txt" at -21, 0, -30
add_object fp3 from "models/fence_simple.txt" at -15, 0, -30
add_object fp4 from "models/fence_simple.txt" at -9, 0, -30
add_object fp5 from "models/fence_simple.txt" at -3, 0, -30
add_object fp6 from "models/fence_simple.txt" at 3, 0, -30
add_object fp7 from "models/fence_simple.txt" at 9, 0, -30
add_object fp8 from "models/fence_simple.txt" at 15, 0, -30
add_object fp9 from "models/fence_simple.txt" at 21, 0, -30
add_object fp10 from "models/fence_simple.txt" at 27, 0, -30
// Back (z = 30)
add_object bp1 from "models/fence_simple.txt" at -27, 0, 30
add_object bp2 from "models/fence_simple.txt" at -21, 0, 30
add_object bp3 from "models/fence_simple.txt" at -15, 0, 30
add_object bp4 from "models/fence_simple.txt" at -9, 0, 30
add_object bp5 from "models/fence_simple.txt" at -3, 0, 30
add_object bp6 from "models/fence_simple.txt" at 3, 0, 30
add_object bp7 from "models/fence_simple.txt" at 9, 0, 30
add_object bp8 from "models/fence_simple.txt" at 15, 0, 30
add_object bp9 from "models/fence_simple.txt" at 21, 0, 30
add_object bp10 from "models/fence_simple.txt" at 27, 0, 30
// Left (x = -30, rotated 90)
add_object lp1 from "models/fence_simple.txt" at -30, 0, -27 rotatey 1.5708
add_object lp2 from "models/fence_simple.txt" at -30, 0, -21 rotatey 1.5708
add_object lp3 from "models/fence_simple.txt" at -30, 0, -15 rotatey 1.5708
add_object lp4 from "models/fence_simple.txt" at -30, 0, -9 rotatey 1.5708
add_object lp5 from "models/fence_simple.txt" at -30, 0, -3 rotatey 1.5708
add_object lp6 from "models/fence_simple.txt" at -30, 0, 3 rotatey 1.5708
add_object lp7 from "models/fence_simple.txt" at -30, 0, 9 rotatey 1.5708
add_object lp8 from "models/fence_simple.txt" at -30, 0, 15 rotatey 1.5708
add_object lp9 from "models/fence_simple.txt" at -30, 0, 21 rotatey 1.5708
add_object lp10 from "models/fence_simple.txt" at -30, 0, 27 rotatey 1.5708
// Right (x = 30, rotated 90)
add_object rp1 from "models/fence_simple.txt" at 30, 0, -27 rotatey 1.5708
add_object rp2 from "models/fence_simple.txt" at 30, 0, -21 rotatey 1.5708
add_object rp3 from "models/fence_simple.txt" at 30, 0, -15 rotatey 1.5708
add_object rp4 from "models/fence_simple.txt" at 30, 0, -9 rotatey 1.5708
add_object rp5 from "models/fence_simple.txt" at 30, 0, -3 rotatey 1.5708
add_object rp6 from "models/fence_simple.txt" at 30, 0, 3 rotatey 1.5708
add_object rp7 from "models/fence_simple.txt" at 30, 0, 9 rotatey 1.5708
add_object rp8 from "models/fence_simple.txt" at 30, 0, 15 rotatey 1.5708
add_object rp9 from "models/fence_simple.txt" at 30, 0, 21 rotatey 1.5708
add_object rp10 from "models/fence_simple.txt" at 30, 0, 27 rotatey 1.5708

// Fence colliders (perimeter walls)
add_collider 0, 1, -29.5 size 30, 5, 0.5
add_collider 0, 1, 29.5 size 30, 5, 0.5
add_collider -29.5, 1, 0 size 0.5, 5, 30
add_collider 29.5, 1, 0 size 0.5, 5, 30

// Boss (static for now, no AI)
let boss = create_model from "models/boss_demon.txt" at 0, 0.5, -20 scale 8

// Boss AI
let boss_timer = 3
let boss_state = "idle"
let boss_leap_y = 0
let boss_base_y = 0.5

// Boss fireball
let fireball = 0
let fireball_active = 0
let fireball_vx = 0
let fireball_vz = 0

// Boss ground slam particles
let sp1 = 0
let sp2 = 0
let sp3 = 0
let sp4 = 0
let sp5 = 0
let sp6 = 0
let sp7 = 0
let sp8 = 0
let spv1x = 0
let spv1y = 0
let spv1z = 0
let spv2x = 0
let spv2y = 0
let spv2z = 0
let spv3x = 0
let spv3y = 0
let spv3z = 0
let spv4x = 0
let spv4y = 0
let spv4z = 0
let spv5x = 0
let spv5y = 0
let spv5z = 0
let spv6x = 0
let spv6y = 0
let spv6z = 0
let spv7x = 0
let spv7y = 0
let spv7z = 0
let spv8x = 0
let spv8y = 0
let spv8z = 0
let slam_particles_alive = 0
let slam_particle_timer = 0

// Blasters (on ground for pickup)
let pistol = create_model from "models/blaster_pistol.txt" at -1, 0.5, -5 rotatey 0.3 scale 2
let rifle = create_model from "models/blaster_rifle.txt" at 1, 0.5, -5 rotatey -0.3 scale 2
let shotgun = create_model from "models/blaster_shotgun.txt" at 0, 0.5, -5.5 rotatey 0 scale 2

// === WEAPON SYSTEM ===
let currentWeapon = 0
let weaponName = "none"
let hasPistol = 0
let hasRifle = 0
let hasShotgun = 0
let shootAnim = 0
let muzzleFlash = 0
let pickupMessage = ""
let pickupTimer = 0
let isReloading = 0
let reloadTimer = 0
let reloadTime = 1.5
let pistolAmmo = 12
let pistolReserve = 36
let pistolMagSize = 12
let rifleAmmo = 30
let rifleReserve = 90
let rifleMagSize = 30
let shotgunAmmo = 8
let shotgunReserve = 24
let shotgunMagSize = 8

// HUD
let game_title = "ALONE"
let player_hp = 100
let max_hp = 100
let score = 0
let sprintTimer = 0
let _time = 0

import("game/scripts/ammo_chests.mio")

on_draw
    let sprinting = camera.sprinting
    let stamina = camera.stamina
    let maxStamina = camera.maxStamina
    if sprinting == true then
        let sprintTimer = sprintTimer + 0.016
    else
        let sprintTimer = 0
    end

    // === Muzzle flash ===
    if muzzleFlash > 0 then
        let muzzleFlash = muzzleFlash - 0.016
        let fa = muzzleFlash * 8
        draw_circle 228, 165, 12 * fa, 1.0, 0.8, 0.2, fa * 0.9
        draw_circle 228, 165, 6 * fa, 1.0, 1.0, 0.6, fa
    end

    // === Weapon display (classic FPS, bottom right) ===
    if isReloading == 0 then
        let wx = 255
        let wy = 180
        let ws = 4.0
        let wr = 0
        if shootAnim > 0 then
            let wr = cos(shootAnim * 30) * 0.15
            let wy = wy + sin(shootAnim * 40) * 8
        end
        if currentWeapon == 1 then
            draw_model "models/blaster_pistol.txt", wx, wy, ws, -0.15 + wr, -0.35
        end
        if currentWeapon == 2 then
            draw_model "models/blaster_rifle.txt", wx, wy, ws, -0.15 + wr, -0.35
        end
        if currentWeapon == 3 then
            draw_model "models/blaster_shotgun.txt", wx, wy, ws, -0.15 + wr, -0.35
        end
    end

    // === Weapon slots indicator ===
    if isReloading == 0 then
        if hasPistol == 1 then
            draw_rect 200, 200, 20, 8, 0.3, 0.3, 0.3, 0.8
        end
        if hasRifle == 1 then
            draw_rect 225, 200, 20, 8, 0.3, 0.3, 0.3, 0.8
        end
        if hasShotgun == 1 then
            draw_rect 250, 200, 20, 8, 0.3, 0.3, 0.3, 0.8
        end
        if currentWeapon == 1 then
            draw_rect 200, 200, 20, 8, 0.2, 0.6, 1.0, 0.9
        end
        if currentWeapon == 2 then
            draw_rect 225, 200, 20, 8, 0.2, 0.6, 1.0, 0.9
        end
        if currentWeapon == 3 then
            draw_rect 250, 200, 20, 8, 0.2, 0.6, 1.0, 0.9
        end
        if currentWeapon > 0 then
            draw_text weaponName, 255, 212, 6, 0.5, 0.5, 0.5, 0.7, center
        end
    end
    // === Reload indicator ===
    if isReloading == 1 then
        let rpct = reloadTimer / reloadTime
        let rw = rpct * 50
        draw_rect 200, 196, 110, 14, 0.05, 0.05, 0.1, 0.85
        draw_rect 201, 198, rw, 10, 0.2, 0.7, 1.0, 0.95
        draw_text "RELOAD", 255, 196, 8, 0.2, 0.7, 1.0, 0.9, center
    end

    // === Crosshair ===
    draw_circle 160, 120, 2, 1, 0.2, 0.2, 0.9
    draw_circle 160, 120, 1, 1, 1, 1, 1

    // === Bottom panel ===
    draw_rect 0, 226, 320, 14, 0.08, 0.02, 0.02, 0.92
    draw_line 0, 226, 320, 226, 0.7, 0.1, 0.1, 0.8, 1

    // === HP ===
    let hp_pct = player_hp / max_hp
    let hp_shake = 0
    if hp_pct < 0.3 then
        let hp_shake = sin(sprintTimer * 30) * 1
    end
    draw_text "" + player_hp, 18 + hp_shake, 227, 8, 0.9, 0.1, 0.1, 1, left
    draw_rect 40, 229, 50, 4, 0.2, 0.05, 0.05, 0.9
    let bar_w = hp_pct * 48
    draw_rect 41, 230, bar_w, 2, 0.9, 0.1, 0.1, 1
    if hp_pct < 0.3 then
        let flash = sin(sprintTimer * 12) * 0.5 + 0.5
        draw_rect 41, 230, bar_w, 2, 1, 0.2 * flash, 0.1, 1
    end

    // === Stamina ===
    draw_rect 96, 229, 50, 4, 0.1, 0.1, 0.2, 0.9
    let st_pct = stamina / maxStamina
    let st_w = st_pct * 48
    draw_rect 97, 230, st_w, 2, 0.2, 0.5, 1.0, 0.95
    if sprinting == true then
        draw_rect 97, 230, st_w, 2, 0.3, 0.8, 1.0, 1
    end

    // === Style ===
    let style_rank = "D"
    let style_r = 0.5
    let style_g = 0.5
    let style_b = 0.5
    if score >= 5 then
        let style_rank = "C"
        let style_r = 0.2
        let style_g = 0.8
        let style_b = 0.2
    end
    if score >= 15 then
        let style_rank = "B"
        let style_r = 0.2
        let style_g = 0.4
        let style_b = 1.0
    end
    if score >= 30 then
        let style_rank = "A"
        let style_r = 0.9
        let style_g = 0.8
        let style_b = 0.1
    end
    if score >= 50 then
        let style_rank = "S"
        let style_r = 1.0
        let style_g = 0.3
        let style_b = 0.1
    end
    if score >= 100 then
        let style_rank = "SSS"
        let style_r = 1.0
        let style_g = 0.0
        let style_b = 0.5
    end
    draw_text style_rank, 170, 227, 9, style_r, style_g, style_b, 1, left
    draw_text "" + score, 190, 228, 6, 0.7, 0.15, 0.1, 0.9, left

    // === Slam ===
    if sprinting == true then
        let sa = 0.7 + sin(sprintTimer * 15) * 0.3
        draw_text "SLAM", 290, 227, 8, 1.0, 0.3, 0.1, sa, right
    end

    // === Title ===
    draw_text game_title, 161, 3, 10, 0, 0, 0, 0.6, center
    draw_text game_title, 160, 2, 10, 0.9, 0.1, 0.1, 1, center

    // === Boss state indicator ===
    let _boss_state_text = ""
    let _bsr = 0.5
    let _bsg = 0.5
    let _bsb = 0.5
    if boss_state == "idle" then
        let _boss_state_text = "DEMON: IDLE"
        let _bsr = 0.4
        let _bsg = 0.4
        let _bsb = 0.4
    end
    if boss_state == "slam_prep" then
        let _boss_state_text = "DEMON: LEAPING!"
        let _bsr = 1.0
        let _bsg = 0.3
        let _bsb = 0.1
    end
    if boss_state == "slam_fall" then
        let _boss_state_text = "DEMON: SLAMMING!"
        let _bsr = 1.0
        let _bsg = 0.1
        let _bsb = 0.0
    end
    if boss_state == "slam_impact" then
        let _boss_state_text = "DEMON: IMPACT!"
        let _bsr = 0.8
        let _bsg = 0.6
        let _bsb = 0.0
    end
    if boss_state == "fireball_prep" then
        let _boss_state_text = "DEMON: FIREBALL!"
        let _bsr = 1.0
        let _bsg = 0.5
        let _bsb = 0.0
    end
    draw_text _boss_state_text, 160, 14, 7, _bsr, _bsg, _bsb, 0.8, center

    // === Ammo display (bottom right) ===
    if currentWeapon > 0 and isReloading == 0 then
        let _ammo = 0
        let _reserve = 0
        let _magSize = 0
        if currentWeapon == 1 then
            let _ammo = pistolAmmo
            let _reserve = pistolReserve
            let _magSize = pistolMagSize
        end
        if currentWeapon == 2 then
            let _ammo = rifleAmmo
            let _reserve = rifleReserve
            let _magSize = rifleMagSize
        end
        if currentWeapon == 3 then
            let _ammo = shotgunAmmo
            let _reserve = shotgunReserve
            let _magSize = shotgunMagSize
        end
        // magazine - big number
        let _ar = 1.0
        let _ag = 1.0
        let _ab = 1.0
        if _ammo <= 0 then
            let _ar = 1.0
            let _ag = 0.15
            let _ab = 0.1
        else
            if _ammo <= _magSize / 4 then
                let _ar = 1.0
                let _ag = 0.7
                let _ab = 0.1
            end
        end
        draw_text "" + _ammo, 275, 226, 10, _ar, _ag, _ab, 1, right
        // reserve - smaller, gray
        draw_text "/ " + _reserve, 310, 229, 7, 0.55, 0.55, 0.6, 0.85, right
    end

    // === Pickup message ===
    if pickupTimer > 0 then
        let pickupTimer = pickupTimer - 0.016
        let pa = min(pickupTimer, 1)
        draw_text pickupMessage, 160, 100, 10, 1.0, 0.9, 0.3, pa, center
    end
end

on_update
    let _time = _time + 0.016
    camera_collide

    // === BOSS AI ===
    // Face player
    let _bdx = camera.x - boss.x
    let _bdz = camera.z - boss.z
    let _bsd = dist(boss.x, boss.y, boss.z, camera.x, camera.y, camera.z)
    if _bsd > 0.1 then
        set_rot boss angle_y atan2(_bdx, -_bdz)
    end

    // Attack timer
    let boss_timer = boss_timer - 0.016
    if boss_timer <= 0 and boss_state == "idle" then
        let boss_state = "slam_prep"
        let boss_timer = 1.0
    end

    // === GROUND SLAM ANIMATION ===
    if boss_state == "slam_prep" then
        // Jump up
        let boss_leap_y = boss_leap_y + 8 * 0.016
        boss.y = boss_base_y + boss_leap_y
        if boss_leap_y >= 4 then
            let boss_state = "slam_fall"
        end
    end

    if boss_state == "slam_fall" then
        // Fall down fast
        let boss_leap_y = boss_leap_y - 20 * 0.016
        boss.y = boss_base_y + boss_leap_y
        if boss_leap_y <= 0 then
            boss.y = boss_base_y
            let boss_leap_y = 0
            let boss_state = "slam_impact"
            let boss_timer = 0.5
            // Spawn impact particles
            let sp1 = create_model from "models/boss_demon.txt" at boss.x, 0.2, boss.z scale 1
            let sp2 = create_model from "models/boss_demon.txt" at boss.x, 0.2, boss.z scale 1
            let sp3 = create_model from "models/boss_demon.txt" at boss.x, 0.2, boss.z scale 1
            let sp4 = create_model from "models/boss_demon.txt" at boss.x, 0.2, boss.z scale 1
            let sp5 = create_model from "models/boss_demon.txt" at boss.x, 0.2, boss.z scale 1
            let sp6 = create_model from "models/boss_demon.txt" at boss.x, 0.2, boss.z scale 1
            let sp7 = create_model from "models/boss_demon.txt" at boss.x, 0.2, boss.z scale 1
            let sp8 = create_model from "models/boss_demon.txt" at boss.x, 0.2, boss.z scale 1
            let spv1x = 6
            let spv1y = 14
            let spv1z = 6
            let spv2x = -6
            let spv2y = 12
            let spv2z = 6
            let spv3x = 6
            let spv3y = 16
            let spv3z = -6
            let spv4x = -6
            let spv4y = 13
            let spv4z = -6
            let spv5x = 8
            let spv5y = 18
            let spv5z = 0
            let spv6x = -8
            let spv6y = 15
            let spv6z = 0
            let spv7x = 0
            let spv7y = 17
            let spv7z = 8
            let spv8x = 0
            let spv8y = 14
            let spv8z = -8
            let slam_particles_alive = 1
            let slam_particle_timer = 0
        end
    end

    if boss_state == "slam_impact" then
        let boss_timer = boss_timer - 0.016
        if boss_timer <= 0 then
            let boss_state = "fireball_prep"
            let boss_timer = 0.8
        end
    end

    // === FIREBALL ATTACK ===
    if boss_state == "fireball_prep" then
        // Lean back slightly (visual cue)
        let boss_timer = boss_timer - 0.016
        if boss_timer <= 0 then
            let boss_state = "fireball_shoot"
            let _fdx = camera.x - boss.x
            let _fdz = camera.z - boss.z
            let _fsd = dist(boss.x, boss.y, boss.z, camera.x, camera.y, camera.z)
            let fireball = create_model from "models/deco_skull.txt" at boss.x, 1.5, boss.z scale 2
            let fireball_vx = _fdx / _fsd * 12
            let fireball_vz = _fdz / _fsd * 12
            let fireball_active = 1
            let boss_timer = 2.0
            let boss_state = "idle"
        end
    end

    // Fireball movement
    if fireball_active == 1 then
        move fireball by fireball_vx * 0.016, 0, fireball_vz * 0.016
        let _fbd = dist(fireball.x, fireball.y, fireball.z, camera.x, camera.y, camera.z)
        if _fbd < 2 or fireball.x > 30 or fireball.x < -30 or fireball.z > 30 or fireball.z < -30 then
            destroy fireball
            let fireball_active = 0
        end
    end

    // === SLAM PARTICLES UPDATE ===
    if slam_particles_alive == 1 then
        let slam_particle_timer = slam_particle_timer + 0.016
        move sp1 by spv1x * 0.016, spv1y * 0.016, spv1z * 0.016
        move sp2 by spv2x * 0.016, spv2y * 0.016, spv2z * 0.016
        move sp3 by spv3x * 0.016, spv3y * 0.016, spv3z * 0.016
        move sp4 by spv4x * 0.016, spv4y * 0.016, spv4z * 0.016
        move sp5 by spv5x * 0.016, spv5y * 0.016, spv5z * 0.016
        move sp6 by spv6x * 0.016, spv6y * 0.016, spv6z * 0.016
        move sp7 by spv7x * 0.016, spv7y * 0.016, spv7z * 0.016
        move sp8 by spv8x * 0.016, spv8y * 0.016, spv8z * 0.016
        let spv1y = spv1y - 25 * 0.016
        let spv2y = spv2y - 25 * 0.016
        let spv3y = spv3y - 25 * 0.016
        let spv4y = spv4y - 25 * 0.016
        let spv5y = spv5y - 25 * 0.016
        let spv6y = spv6y - 25 * 0.016
        let spv7y = spv7y - 25 * 0.016
        let spv8y = spv8y - 25 * 0.016
        if slam_particle_timer >= 1.5 then
            destroy sp1
            destroy sp2
            destroy sp3
            destroy sp4
            destroy sp5
            destroy sp6
            destroy sp7
            destroy sp8
            let slam_particles_alive = 0
            let slam_particle_timer = 0
        end
    end

    // shooting animation decay
    if shootAnim > 0 then
        let shootAnim = shootAnim - 0.016
    end

    // reload timer
    if isReloading == 1 then
        let reloadTimer = reloadTimer - 0.016
        if reloadTimer <= 0 then
            let isReloading = 0
            let reloadTimer = 0
            if currentWeapon == 1 then
                let _need = pistolMagSize - pistolAmmo
                if _need > pistolReserve then
                    let _need = pistolReserve
                end
                let pistolAmmo = pistolAmmo + _need
                let pistolReserve = pistolReserve - _need
            end
            if currentWeapon == 2 then
                let _need = rifleMagSize - rifleAmmo
                if _need > rifleReserve then
                    let _need = rifleReserve
                end
                let rifleAmmo = rifleAmmo + _need
                let rifleReserve = rifleReserve - _need
            end
            if currentWeapon == 3 then
                let _need = shotgunMagSize - shotgunAmmo
                if _need > shotgunReserve then
                    let _need = shotgunReserve
                end
                let shotgunAmmo = shotgunAmmo + _need
                let shotgunReserve = shotgunReserve - _need
            end
        end
    end

    // pickup check
    let px = camera.x
    let pz = camera.z
    if hasPistol == 0 then
        let d1 = dist(px, 0, pz, -1, 0.5, -5)
        if d1 < 2 then
            let hasPistol = 1
            let currentWeapon = 1
            let weaponName = "PISTOL"
            let pickupMessage = "PICKUP: PISTOL"
            let pickupTimer = 2
            destroy pistol
        end
    end
    if hasRifle == 0 then
        let d2 = dist(px, 0, pz, 1, 0.5, -5)
        if d2 < 2 then
            let hasRifle = 1
            let currentWeapon = 2
            let weaponName = "RIFLE"
            let pickupMessage = "PICKUP: RIFLE"
            let pickupTimer = 2
            destroy rifle
        end
    end
    if hasShotgun == 0 then
        let d3 = dist(px, 0, pz, 0, 0.5, -5.5)
        if d3 < 2 then
            let hasShotgun = 1
            let currentWeapon = 3
            let weaponName = "SHOTGUN"
            let pickupMessage = "PICKUP: SHOTGUN"
            let pickupTimer = 2
            destroy shotgun
        end
    end

    // blasters rotate on ground (only if not picked up)
    if hasPistol == 0 then
        set_rot angle_y pistol _time * 0.8
        pistol.y = 0.5 + sin(_time * 1.5) * 0.05
    end
    if hasRifle == 0 then
        set_rot angle_y rifle _time * 0.6
        rifle.y = 0.5 + sin(_time * 1.8 + 1) * 0.05
    end
    if hasShotgun == 0 then
        set_rot angle_y shotgun _time * 0.5
        shotgun.y = 0.5 + sin(_time * 1.2 + 2) * 0.05
    end
end

on_mouse
    if _mousebutton == 1 and _mouseaction == "pressed" then
        if currentWeapon > 0 and isReloading == 0 then
            let _canShoot = 0
            if currentWeapon == 1 and pistolAmmo > 0 then
                let _canShoot = 1
                let pistolAmmo = pistolAmmo - 1
            end
            if currentWeapon == 2 and rifleAmmo > 0 then
                let _canShoot = 1
                let rifleAmmo = rifleAmmo - 1
            end
            if currentWeapon == 3 and shotgunAmmo > 0 then
                let _canShoot = 1
                let shotgunAmmo = shotgunAmmo - 1
            end
            if _canShoot == 1 then
                let shootAnim = 0.2
                let muzzleFlash = 0.1
            end
        end
    end
end

on_key "m"
    mute
end

on_key "r"
    if currentWeapon > 0 and isReloading == 0 then
        let _canReload = 0
        if currentWeapon == 1 and pistolAmmo < pistolMagSize and pistolReserve > 0 then
            let _canReload = 1
            let reloadTime = 1.0
            let reloadTimer = 1.0
        end
        if currentWeapon == 2 and rifleAmmo < rifleMagSize and rifleReserve > 0 then
            let _canReload = 1
            let reloadTime = 2.0
            let reloadTimer = 2.0
        end
        if currentWeapon == 3 and shotgunAmmo < shotgunMagSize and shotgunReserve > 0 then
            let _canReload = 1
            let reloadTime = 1.8
            let reloadTimer = 1.8
        end
        if _canReload == 1 then
            let isReloading = 1
            let shootAnim = 0
            let muzzleFlash = 0
        end
    end
end

on_key "1"
    if hasPistol == 1 then
        let currentWeapon = 1
        let weaponName = "PISTOL"
    end
end

on_key "2"
    if hasRifle == 1 then
        let currentWeapon = 2
        let weaponName = "RIFLE"
    end
end

on_key "3"
    if hasShotgun == 1 then
        let currentWeapon = 3
        let weaponName = "SHOTGUN"
    end
end
